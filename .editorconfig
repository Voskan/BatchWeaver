# EditorConfig helps maintain consistent coding styles across editors and IDEs.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Trailing whitespace is significant in Markdown (two spaces = hard line break),
# so it is not trimmed here.
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
